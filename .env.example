
PORT=8000
# WAJIB diisi, minimal 32 karakter. Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=1d

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bot_wa

# Origin frontend yang diizinkan (CORS). Pisah dengan koma untuk banyak origin.
# Kosongkan hanya saat development lokal. Contoh: https://example.com,https://example2.com
CORS_ORIGIN=

VITE_API_BASE_URL=
